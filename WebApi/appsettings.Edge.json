{
  "ExecutionProfile": "Edge",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5055"
      }
    }
  },
  "ConnectionStrings": {
    "SqliteConnection": "Data Source=mesafacil_edge.db;Cache=Shared"
  },
  "Sync": {
    "CloudBaseUrl": "",
    "IntervalSeconds": 30,
    "PingTimeoutSeconds": 5,
    "BatchSize": 100
  },
  "Config": {
    "OriginCors": "*",
    "Secret": "[REDACTED]",
    "Issuer": "OrionSys",
    "Audience": "OrionSys"
  },
  "WatchDog": {
    "WatchPageUsername": "admin",
    "WatchPagePassword": "admin"
  },
  "Jwt": {
    "Issuer": "MesaFacil.Api",
    "Audience": "MesaFacil.Client",
    "SigningKey": "[REDACTED]",
    "ExpMinutes": 720
  },
  "FeatureGating": {
    "Enabled": false
  }
}
